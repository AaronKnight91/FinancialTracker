# Optional: fills gaps when Yahoo Finance data is missing/stale for UK tickers,
# and (if set) can be used as the ticker source for `--discover --discover-source fmp`.
# Get a free key at https://site.financialmodelingprep.com/developer/docs
# Leave blank to use yfinance + the Wikipedia FTSE universe only.
FMP_API_KEY=

# How long (hours) fetched fundamentals stay cached before a re-fetch. Default 24.
CACHE_TTL_HOURS=24
