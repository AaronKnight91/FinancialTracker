# Optional: fills gaps when Yahoo Finance data is missing/stale for UK tickers,
# and (if set) can be used as the ticker source for `--discover --discover-source fmp`.
# Get a free key at https://site.financialmodelingprep.com/developer/docs
# Leave blank to use yfinance + the Wikipedia FTSE universe only.
FMP_API_KEY=

# How long (hours) fetched fundamentals stay cached before a re-fetch. Default 24.
CACHE_TTL_HOURS=24

# Optional: base folder for broker export CSVs (see --import-portfolio),
# with one subfolder per portfolio, e.g.:
#   C:\Users\yourname\Data\Financials\raw\ISA\
#   C:\Users\yourname\Data\Financials\raw\GIA\
# then BROKER_EXPORTS_DIR is the "raw" folder above (NOT including the
# portfolio name) -- the tool appends \<portfolio name>\ itself:
#   python main.py --import-portfolio --portfolio-name ISA   # scans .../raw/ISA/
#   python main.py --import-portfolio                        # no name: imports every subfolder found
# Leave blank to use ./broker_exports (created automatically) or pass
# --broker-exports-dir on the command line instead.
BROKER_EXPORTS_DIR=
